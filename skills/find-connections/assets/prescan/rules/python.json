{
 "language": "python",
 "rules": [
  {
   "id": "py.web.route",
   "form": "call",
   "in_decorator": true,
   "methods": [
    "get",
    "post",
    "put",
    "patch",
    "delete",
    "route",
    "api_route",
    "head",
    "options"
   ],
   "protocol": "http",
   "direction": "inbound",
   "method": {
    "kwarg": [
     "methods"
    ],
    "fallback": "name"
   },
   "value": [
    {
     "arg": 0
    },
    {
     "kwarg": [
      "path",
      "rule"
     ]
    }
   ]
  },
  {
   "id": "py.django.url",
   "form": "call",
   "no_object": true,
   "files": [
    "urls.py"
   ],
   "methods": [
    "path",
    "re_path",
    "url"
   ],
   "protocol": "http",
   "direction": "inbound",
   "value": [
    {
     "arg": 0
    }
   ],
   "mark_if_arg": {
    "arg": 1,
    "calls": [
     "include"
    ],
    "note": "include() entry: it is a prefix prepended to the routes of the included urls.py, not an endpoint of its own",
    "confidence": "uncertain"
   }
  },
  {
   "id": "py.http.client",
   "form": "call",
   "group": "py.http",
   "object_regex": "^(requests|httpx|aiohttp|\\w*[Ss]ession|\\w*[Cc]lient|self\\.\\w*([Ss]ession|[Cc]lient))$",
   "methods": [
    "get",
    "post",
    "put",
    "patch",
    "delete",
    "head",
    "options"
   ],
   "protocol": "http",
   "direction": "outbound",
   "method": "name",
   "value": [
    {
     "arg": 0
    },
    {
     "kwarg": [
      "url"
     ]
    }
   ]
  },
  {
   "id": "py.http.generic",
   "form": "call",
   "group": "py.http",
   "methods": [
    "get",
    "post",
    "put",
    "patch",
    "delete"
   ],
   "protocol": "http",
   "direction": "outbound",
   "method": "name",
   "value": [
    {
     "arg": 0
    }
   ],
   "value_filter": "url-or-path",
   "confidence": "uncertain",
   "note": "object not recognized as an HTTP client: confirm it is a network call"
  },
  {
   "id": "py.urllib",
   "form": "call",
