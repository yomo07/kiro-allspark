  {
   "id": "py.rabbit.publish",
   "form": "call",
   "methods": [
    "basic_publish"
   ],
   "protocol": "queue-rabbitmq",
   "direction": "outbound",
   "value": [
    {
     "join": [
      {
       "kwarg": [
        "exchange"
       ]
      },
      {
       "kwarg": [
        "routing_key"
       ]
      }
     ],
     "sep": "/"
    },
    {
     "join": [
      {
       "arg": 0
      },
      {
       "arg": 1
      }
     ],
     "sep": "/",
     "min_args": 2
    }
   ]
  },
